---
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
import BadgeEtat from "../../components/BadgeEtat.astro";
import { SELECTION_PRODUIT, STATUTS, versProduit, formaterPrix, type Produit } from "../../lib/produits";

const supabase = Astro.locals.supabase;
const { data, error } = await supabase
  .from("produits")
  .select(SELECTION_PRODUIT)
  .order("date_ajout", { ascending: false });
const tous: Produit[] = (data ?? []).map(versProduit);

const SEUIL_STOCK_BAS = 2;
const enVente = (p: Produit) => p.visible && p.statut === "disponible" && p.stock > 0;
const stockBas = (p: Produit) => p.statut === "disponible" && p.stock <= SEUIL_STOCK_BAS;

const q = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase();
const filtre = Astro.url.searchParams.get("filtre") ?? "";
const filtres: { cle: string; libelle: string; test: (p: Produit) => boolean }[] = [
  { cle: "", libelle: "Tous", test: () => true },
  { cle: "en-vente", libelle: "En vente", test: enVente },
  { cle: "stock-bas", libelle: "Stock bas", test: stockBas },
  { cle: "vendus", libelle: "Vendus ou en rupture", test: (p) => p.statut !== "disponible" },
  { cle: "masques", libelle: "Masqués", test: (p) => !p.visible },
];
const test = filtres.find((f) => f.cle === filtre)?.test ?? (() => true);
const liste = tous.filter(
  (p) => test(p) && (!q || `${p.nom} ${p.marque} ${p.reference}`.toLowerCase().includes(q)),
);
const nbStockBas = tous.filter(stockBas).length;
const retour = Astro.url.pathname + Astro.url.search;
const lienFiltre = (cle: string) => `/admin?${new URLSearchParams({ ...(q ? { q } : {}), ...(cle ? { filtre: cle } : {}) })}`;
---

<LayoutAdmin titre="Produits">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-titre text-3xl font-extrabold">Produits</h1>
    <a href="/admin/produits/nouveau" class="btn btn-marque">+ Ajouter un produit</a>
  </div>

  {Astro.url.searchParams.get("supprime") && <p role="status" class="mt-4 rounded-lg bg-emerald-50 p-3 font-semibold text-emerald-800">Produit supprimé.</p>}
  {error && <p role="alert" class="mt-4 rounded-lg bg-red-50 p-3 font-semibold text-red-800">Impossible de charger les produits : {error.message}</p>}

  <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="carte"><p class="text-sm text-encre/60">Produits</p><p class="font-titre text-3xl font-extrabold">{tous.length}</p></div>
    <div class="carte"><p class="text-sm text-encre/60">En vente</p><p class="font-titre text-3xl font-extrabold text-emerald-700">{tous.filter(enVente).length}</p></div>
    <div class="carte"><p class="text-sm text-encre/60">Stock bas</p><p class="font-titre text-3xl font-extrabold text-amber-700">{nbStockBas}</p></div>
    <div class="carte"><p class="text-sm text-encre/60">Masqués</p><p class="font-titre text-3xl font-extrabold">{tous.filter((p) => !p.visible).length}</p></div>
  </div>

  {
    nbStockBas > 0 && filtre !== "stock-bas" && (
      <p class="mt-4 rounded-lg bg-amber-50 p-3 font-semibold text-amber-900">
        {nbStockBas} produit{nbStockBas > 1 ? "s ont" : " a"} un stock bas (2 ou moins).{" "}
        <a href={lienFiltre("stock-bas")} class="underline">Voir la liste</a>
      </p>
    )
  }

  <form method="get" class="mt-5 flex flex-col gap-3 sm:flex-row">
    <input type="search" name="q" value={q} placeholder="Rechercher un nom, une marque, une référence" class="champ sm:max-w-md" />
    {filtre && <input type="hidden" name="filtre" value={filtre} />}
    <button class="btn btn-clair">Rechercher</button>
  </form>

  <nav class="mt-3 flex flex-wrap gap-2" aria-label="Filtrer la liste">
    {
      filtres.map((f) => (
        <a
          href={lienFiltre(f.cle)}
          aria-current={filtre === f.cle ? "true" : undefined}
          class="rounded-full border border-encre/15 bg-white px-4 py-1.5 text-sm font-bold aria-[current=true]:border-marque aria-[current=true]:bg-marque aria-[current=true]:text-white"
        >
          {f.libelle}
        </a>
      ))
    }
  </nav>

  <ul class="mt-5 space-y-3">
    {liste.length === 0 && <li class="carte text-encre/70">Aucun produit ne correspond.</li>}
    {
      liste.map((p) => (
        <li class="carte flex flex-col gap-4 md:flex-row md:items-center">
          <a href={`/admin/produits/${p.id}`} class="flex min-w-0 flex-1 items-center gap-4">
            {p.images[0] ? (
              <img src={p.images[0]} alt="" loading="lazy" class="h-20 w-20 shrink-0 rounded-lg object-cover" />
            ) : (
              <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-lg bg-papier text-xs text-encre/50">Sans photo</span>
            )}
            <span class="min-w-0">
              <span class="block font-titre text-lg font-bold leading-snug">{p.nom}</span>
              <span class="block text-sm text-encre/70">{p.categorieNom} · {p.reference}</span>
              <span class="mt-1 flex flex-wrap items-center gap-2">
                <BadgeEtat etat={p.etat} />
                <span class="font-bold text-marque">{formaterPrix(p.prix)}</span>
              </span>
            </span>
          </a>

          <div class="flex flex-wrap items-center gap-2 text-sm font-bold md:w-60 md:justify-end">
            <span class:list={["rounded-full px-3 py-1", p.statut === "disponible" ? "bg-emerald-100 text-emerald-900" : "bg-red-100 text-red-800"]}>
              {STATUTS[p.statut]}
            </span>
            <span class:list={["rounded-full px-3 py-1", stockBas(p) ? "bg-amber-100 text-amber-900" : "bg-papier text-encre/70"]}>
              Stock : {p.stock}
            </span>
            {!p.visible && <span class="rounded-full bg-encre/10 px-3 py-1">Masqué</span>}
          </div>

          <form method="post" action={`/admin/produits/${p.id}`} class="flex flex-wrap gap-2">
            <input type="hidden" name="retour" value={retour} />
            {p.statut === "disponible" ? (
              <>
                <button name="action" value="vendu" class="btn btn-clair px-3 py-2 text-sm">Vendu</button>
                <button name="action" value="rupture" class="btn btn-clair px-3 py-2 text-sm">Rupture</button>
              </>
            ) : (
              <button name="action" value="remettre" class="btn btn-clair px-3 py-2 text-sm">Remettre en vente</button>
            )}
            <button name="action" value={p.visible ? "masquer" : "afficher"} class="btn btn-clair px-3 py-2 text-sm">
              {p.visible ? "Masquer" : "Afficher"}
            </button>
          </form>
        </li>
      ))
    }
  </ul>
</LayoutAdmin>
