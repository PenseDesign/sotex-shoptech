---
import Layout from "../layouts/Layout.astro";
import BoutonWhatsApp from "../components/BoutonWhatsApp.astro";
import { lienWhatsApp } from "../lib/produits";

const boutique = Astro.locals.boutique;
const lienWa = lienWhatsApp(
  "Bonjour, je souhaite passer à la boutique. Quel est le meilleur moment ?",
  boutique.whatsapp.numero,
);
---

<Layout
  titre="Contact et livraison"
  description={`Retrouvez ${boutique.nom} à Douala-Yassa : adresse, horaires de retrait et modes de livraison au Cameroun.`}
>
  <section class="border-b border-encre/10 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-10">
      <h1 class="font-titre text-4xl font-extrabold tracking-tight">Contact et livraison</h1>
      <p class="mt-3 max-w-2xl text-lg text-encre/80">
        Passez à la boutique, écrivez-nous sur WhatsApp ou faites-vous livrer. Dans tous les cas, vous contrôlez l'appareil avant de payer.
      </p>
    </div>
  </section>

  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 lg:grid-cols-2">
    <!-- Localisation -->
    <section class="rounded-2xl border border-encre/10 bg-white p-6" aria-labelledby="titre-lieu">
      <h2 id="titre-lieu" class="font-titre text-2xl font-extrabold">Où nous trouver</h2>
      <address class="mt-4 text-lg not-italic leading-relaxed">
        <strong>{boutique.nom}</strong><br />
        {boutique.adresse.ligne1}<br />
        {boutique.adresse.ville}, {boutique.adresse.pays}
      </address>
      <p class="mt-3 text-encre/70">{boutique.adresse.repere}</p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <a
          href={boutique.adresse.lienCarte}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-xl border-2 border-marque px-5 py-3 font-bold text-marque transition-colors hover:bg-marque hover:text-white"
        >
          Ouvrir dans Google Maps
        </a>
        <BoutonWhatsApp href={lienWa} libelle="Prévenir de ma visite" />
      </div>
      <p class="mt-4 text-sm text-encre/70">
        Écrivez-nous avant de venir : l'appareil sera prêt et testé à votre arrivée. WhatsApp :
        <a class="font-bold text-marque" href={`https://wa.me/${boutique.whatsapp.numero}`}>{boutique.whatsapp.numeroAffiche}</a>
        {boutique.email && <>. E-mail : <a class="font-bold text-marque" href={`mailto:${boutique.email}`}>{boutique.email}</a></>}
      </p>
    </section>

    <!-- Horaires -->
    <section class="rounded-2xl border border-encre/10 bg-white p-6" aria-labelledby="titre-horaires">
      <h2 id="titre-horaires" class="font-titre text-2xl font-extrabold">Horaires de retrait en boutique</h2>
      <table class="mt-4 w-full text-left">
        <caption class="sr-only">Horaires d'ouverture de la boutique</caption>
        <tbody class="divide-y divide-encre/10">
          {
            boutique.horaires.map((h) => (
              <tr>
                <th scope="row" class="py-3 pr-4 font-semibold">{h.jours}</th>
                <td class="py-3 text-right text-lg font-bold text-marque">{h.heures}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-4 text-sm text-encre/70">
        Hors de ces horaires, prenez rendez-vous par WhatsApp. Nous essayons de nous adapter.
      </p>
    </section>
  </div>

  <!-- Livraison -->
  <section class="mx-auto max-w-6xl px-4 pb-4" aria-labelledby="titre-livraison">
    <h2 id="titre-livraison" class="font-titre text-3xl font-extrabold tracking-tight">Modes de livraison</h2>
    <p class="mt-2 max-w-2xl text-encre/80">
      Choisissez ce qui vous convient. Le tarif exact est confirmé par le gestionnaire sur WhatsApp avant la commande.
    </p>
    <ul class="mt-8 grid gap-5 md:grid-cols-2">
      {
        boutique.livraison.map((l) => (
          <li class="flex flex-col rounded-2xl border border-encre/10 bg-white p-6">
            <h3 class="font-titre text-xl font-bold">{l.titre}</h3>
            <p class="mt-1 font-bold text-marque">{l.zone}</p>
            <p class="mt-3 text-encre/80">{l.detail}</p>
            <dl class="mt-4 space-y-2 border-t border-encre/10 pt-4 text-sm">
              <div class="flex gap-2">
                <dt class="font-bold">Délai :</dt>
                <dd>{l.delai}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="font-bold">Paiement :</dt>
                <dd>{l.paiement}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
