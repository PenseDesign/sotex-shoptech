---
import Layout from "../layouts/Layout.astro";
import CarteProduit from "../components/CarteProduit.astro";
import IconeCategorie from "../components/IconeCategorie.astro";
import BoutonWhatsApp from "../components/BoutonWhatsApp.astro";
import { chargerProduitsPublics, disponibilite, lienWhatsApp } from "../lib/produits";

const boutique = Astro.locals.boutique;
const enStock = (await chargerProduitsPublics(Astro.locals.db)).filter((p) => disponibilite(p).enStock);
const nouveautes = enStock.slice(0, 4);
const total = enStock.length;
const categories = boutique.categories.map((c) => ({
  ...c,
  nombre: enStock.filter((p) => p.categorie === c.slug).length,
}));
const lienWa = lienWhatsApp(boutique.whatsapp.messageAccueil, boutique.whatsapp.numero);

const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: boutique.faq.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.reponse },
  })),
};
---

<Layout>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaFaq)} />

  <!-- HERO -->
  <section class="bg-marque text-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-[1.15fr_1fr] md:items-center md:py-20">
      <div>
        <h1 class="font-titre text-4xl font-extrabold leading-[1.05] tracking-tight md:text-6xl">
          Du matériel d'Europe, vérifié avant que vous ne payiez.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/85">
          Chromebooks, tablettes éducatives et laptops d'occasion importés d'Europe. Chaque appareil est
          contrôlé par nos soins, puis vous le vérifiez vous-même à la livraison avant de régler.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/boutique"
            class="inline-flex items-center justify-center rounded-xl bg-accent px-6 py-4 text-lg font-bold text-encre transition-colors hover:brightness-95"
          >
            Voir les {total} appareils en stock
          </a>
          <a
            href={lienWa}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-xl border-2 border-white/40 px-6 py-4 text-lg font-bold transition-colors hover:bg-white/10"
          >
            Poser une question sur WhatsApp
          </a>
        </div>
      </div>

      <div class="rounded-2xl bg-white p-6 text-encre shadow-xl">
        <h2 class="font-titre text-xl font-bold">Contrôle avant mise en vente</h2>
        <p class="mt-1 text-sm text-encre/70">Chaque appareil passe ces vérifications avant d'arriver en rayon.</p>
        <ul class="mt-5 divide-y divide-encre/10">
          {
            boutique.controle.map((c) => (
              <li class="flex items-center justify-between gap-4 py-3">
                <span class="flex items-center gap-3 font-semibold">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-whatsapp" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                  {c.point}
                </span>
                <span class="text-right text-sm text-encre/70">{c.resultat}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- CATÉGORIES -->
  <section class="mx-auto max-w-6xl px-4 pt-16" aria-labelledby="titre-categories">
    <h2 id="titre-categories" class="font-titre text-3xl font-extrabold tracking-tight">Choisissez votre catégorie</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((c) => (
          <a
            href={`/boutique?categorie=${c.slug}`}
            class="group flex flex-col rounded-2xl border border-encre/10 bg-white p-6 transition-colors hover:border-marque"
          >
            <span class="flex h-16 w-16 items-center justify-center rounded-xl bg-marque/10 text-marque">
              <IconeCategorie icone={c.icone} class="h-10 w-10" />
            </span>
            <h3 class="mt-5 font-titre text-xl font-bold group-hover:text-marque">{c.nom}</h3>
            <p class="mt-2 text-encre/70">{c.description}</p>
            <p class="mt-4 text-sm font-bold text-marque">
              {c.nombre} appareil{c.nombre > 1 ? "s" : ""} en stock
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- DERNIERS ARRIVAGES -->
  <section class="mx-auto max-w-6xl px-4 pt-16" aria-labelledby="titre-nouveautes">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="titre-nouveautes" class="font-titre text-3xl font-extrabold tracking-tight">Derniers arrivages</h2>
      <a href="/boutique" class="font-bold text-marque underline underline-offset-4">Voir tout le catalogue</a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {nouveautes.map((p) => <CarteProduit produit={p} />)}
    </div>
  </section>

  <!-- FAQ DE CONFIANCE -->
  <section class="mx-auto max-w-3xl px-4 pt-16" aria-labelledby="titre-faq">
    <h2 id="titre-faq" class="font-titre text-3xl font-extrabold tracking-tight">Vos questions avant de commander</h2>
    <div class="mt-8 divide-y divide-encre/10 rounded-2xl border border-encre/10 bg-white">
      {
        boutique.faq.map((f) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold [&::-webkit-details-marker]:hidden">
              {f.question}
              <span class="text-2xl leading-none text-marque transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 max-w-prose text-encre/80">{f.reponse}</p>
          </details>
        ))
      }
    </div>
    <div class="mt-8 rounded-2xl bg-marque p-6 text-white md:flex md:items-center md:justify-between md:gap-8">
      <p class="font-titre text-xl font-bold">Une autre question ? Le gestionnaire vous répond sur WhatsApp.</p>
      <div class="mt-4 md:mt-0 md:w-72 md:shrink-0">
        <BoutonWhatsApp href={lienWa} libelle="Écrire sur WhatsApp" />
      </div>
    </div>
  </section>
</Layout>
