---
import Layout from "../layouts/Layout.astro";
---

<Layout titre="Page introuvable" noindex>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <h1 class="font-titre text-4xl font-extrabold">Cette page n'existe pas.</h1>
    <p class="mt-4 text-lg text-encre/80">Le lien est peut-être ancien. Retrouvez tous nos appareils dans la boutique.</p>
    <a href="/boutique" class="mt-8 inline-block rounded-xl bg-marque px-6 py-4 text-lg font-bold text-white hover:bg-marque-fonce">
      Aller à la boutique
    </a>
  </section>
</Layout>
