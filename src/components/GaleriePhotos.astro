---
import ProduitImage from "./ProduitImage.astro";
import type { Produit } from "../lib/produits";

interface Props {
  produit: Produit;
}
const { produit } = Astro.props;
const photos = produit.images;
---

<div>
  <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-encre/10 bg-white">
    {
      photos[0] ? (
        <img id="photo-principale" src={photos[0]} alt={produit.nom} width="800" height="600" class="h-full w-full object-contain" />
      ) : (
        <ProduitImage produit={produit} class="h-full w-full" />
      )
    }
  </div>
  {
    photos.length > 1 && (
      <ul class="mt-3 grid grid-cols-5 gap-2">
        {photos.map((url, i) => (
          <li>
            <button
              type="button"
              data-photo={url}
              aria-label={`Voir la photo ${i + 1}`}
              aria-current={i === 0 ? "true" : "false"}
              class="block aspect-square w-full overflow-hidden rounded-lg border-2 border-transparent bg-white aria-[current=true]:border-marque"
            >
              <img src={url} alt="" loading="lazy" class="h-full w-full object-cover" />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<script>
  const principale = document.getElementById("photo-principale") as HTMLImageElement | null;
  const miniatures = document.querySelectorAll<HTMLButtonElement>("[data-photo]");
  miniatures.forEach((b) =>
    b.addEventListener("click", () => {
      if (principale && b.dataset.photo) principale.src = b.dataset.photo;
      miniatures.forEach((x) => x.setAttribute("aria-current", String(x === b)));
    }),
  );
</script>
