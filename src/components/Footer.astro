---
const boutique = Astro.locals.boutique;
const annee = new Date().getFullYear();
---

<footer class="mt-16 bg-encre text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-3">
    <div>
      <p class="font-titre text-xl font-extrabold">{boutique.nom}</p>
      <p class="mt-3 max-w-xs text-white/70">{boutique.slogan}.</p>
    </div>

    <div>
      <h2 class="font-titre text-lg font-bold">Nous trouver</h2>
      <address class="mt-3 not-italic text-white/70">
        {boutique.adresse.ligne1}<br />
        {boutique.adresse.ville}, {boutique.adresse.pays}
      </address>
      <p class="mt-3 text-white/70">
        WhatsApp :
        <a class="font-semibold text-white underline" href={`https://wa.me/${boutique.whatsapp.numero}`}>
          {boutique.whatsapp.numeroAffiche}
        </a>
      </p>
    </div>

    <div>
      <h2 class="font-titre text-lg font-bold">Horaires</h2>
      <ul class="mt-3 space-y-1 text-white/70">
        {
          boutique.horaires.map((h) => (
            <li class="flex justify-between gap-4">
              <span>{h.jours}</span>
              <span class="font-semibold text-white">{h.heures}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-sm text-white/60">
    © {annee} {boutique.nom}. Tous droits réservés.
  </div>
</footer>
