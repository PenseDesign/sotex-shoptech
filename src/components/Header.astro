---
// src/components/Header.astro : REMPLACE entièrement l'ancien fichier
import { lienWhatsApp } from "../lib/produits";

const boutique = Astro.locals.boutique;
const { pathname } = Astro.url;

const liens = [
  { href: "/", libelle: "Accueil" },
  { href: "/boutique", libelle: "Boutique" },
  { href: "/contact", libelle: "Contact" },
];
const actif = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));

const lienWa = lienWhatsApp(boutique.whatsapp.messageAccueil, boutique.whatsapp.numero);
const premierHoraire = boutique.horaires[0];
const initiale = boutique.nom.trim().charAt(0).toUpperCase();
---

<!-- Barre d'information (défile avec la page) -->
<div class="bg-encre text-sm text-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2">
    <p class="hidden truncate text-white/80 sm:block">
      {boutique.adresse.ville}{premierHoraire ? ` · ${premierHoraire.jours} : ${premierHoraire.heures}` : ""}
    </p>
    <a
      href={`https://wa.me/${boutique.whatsapp.numero}`}
      target="_blank"
      rel="noopener noreferrer"
      class="ml-auto font-bold transition-colors hover:text-accent"
    >
      WhatsApp : {boutique.whatsapp.numeroAffiche}
    </a>
  </div>
</div>

<!-- Barre principale (reste visible en haut de l'écran) -->
<header class="sticky top-0 z-40 border-b-4 border-accent bg-white shadow-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:py-4">
    <a href="/" class="flex min-w-0 items-center gap-3" aria-label={`${boutique.nom}, retour à l'accueil`}>
      {
        boutique.logo ? (
          <img
            src={boutique.logo}
            alt=""
            width="200"
            height="80"
            class="h-12 w-auto max-w-[10rem] object-contain md:h-16 md:max-w-[14rem]"
          />
        ) : (
          <span
            aria-hidden="true"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-marque font-titre text-2xl font-extrabold text-white md:h-14 md:w-14"
          >
            {initiale}
          </span>
        )
      }
      <!-- Avec un logo, le nom est masqué sur mobile pour gagner de la place. Supprimez "hidden sm:block" pour toujours l'afficher. -->
      <span
        class:list={[
          "truncate font-titre text-xl font-extrabold leading-tight tracking-tight text-marque md:text-3xl",
          boutique.logo && "hidden sm:block",
        ]}
      >
        {boutique.nom}
      </span>
    </a>

    <!-- Navigation ordinateur -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Navigation principale">
      {
        liens.map((l) => (
          <a
            href={l.href}
            aria-current={actif(l.href) ? "page" : undefined}
            class:list={[
              "border-b-4 py-1 text-lg font-bold transition-colors",
              actif(l.href)
                ? "border-accent text-marque"
                : "border-transparent text-encre/70 hover:text-marque",
            ]}
          >
            {l.libelle}
          </a>
        ))
      }
      <a
        href={lienWa}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl bg-whatsapp px-6 py-3 text-lg font-bold text-white shadow-md transition-colors hover:bg-whatsapp-fonce"
      >
        Commander sur WhatsApp
      </a>
    </nav>

    <!-- Menu mobile -->
    <details class="relative md:hidden">
      <summary
        aria-label="Ouvrir le menu"
        class="flex h-12 w-12 cursor-pointer list-none items-center justify-center rounded-xl border-2 border-marque text-marque [&::-webkit-details-marker]:hidden"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </summary>
      <nav
        class="absolute right-0 mt-3 w-64 rounded-2xl border border-encre/10 bg-white p-2 shadow-xl"
        aria-label="Navigation mobile"
      >
        {
          liens.map((l) => (
            <a
              href={l.href}
              aria-current={actif(l.href) ? "page" : undefined}
              class:list={[
                "block rounded-xl px-4 py-3 text-lg font-bold",
                actif(l.href) ? "bg-marque/10 text-marque" : "text-encre/80",
              ]}
            >
              {l.libelle}
            </a>
          ))
        }
        <a
          href={lienWa}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 block rounded-xl bg-whatsapp px-4 py-3 text-center text-lg font-bold text-white"
        >
          Écrire sur WhatsApp
        </a>
      </nav>
    </details>
  </div>
</header>