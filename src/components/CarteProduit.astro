---
import ProduitImage from "./ProduitImage.astro";
import BadgeEtat from "./BadgeEtat.astro";
import { formaterPrix, disponibilite, type Produit } from "../lib/produits";

interface Props {
  produit: Produit;
}
const { produit } = Astro.props;
const dispo = disponibilite(produit);
---

<a
  href={`/produit/${produit.slug}`}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-encre/10 bg-white transition-colors hover:border-marque"
>
  <div class="relative aspect-[4/3] bg-papier">
    <ProduitImage produit={produit} class="h-full w-full" />
    <BadgeEtat etat={produit.etat} class="absolute left-3 top-3" />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <p class="text-sm text-encre/60">{produit.categorieNom}</p>
    <h3 class="font-titre text-lg font-bold leading-snug group-hover:text-marque">{produit.nom}</h3>
    <p class="text-sm text-encre/70">{produit.resume}</p>
    <div class="mt-auto pt-3">
      <p class="font-titre text-2xl font-extrabold text-marque">{formaterPrix(produit.prix)}</p>
      <p class:list={["text-sm font-semibold", dispo.classe]}>{dispo.libelle}</p>
    </div>
  </div>
</a>
