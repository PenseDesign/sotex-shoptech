---
import IconeCategorie from "./IconeCategorie.astro";
import type { Produit } from "../lib/produits";

interface Props {
  produit: Produit;
  class?: string;
  prioritaire?: boolean;
}
const { produit, class: classe = "", prioritaire = false } = Astro.props;
const photo = produit.images[0];
---

{
  photo ? (
    <img
      src={photo}
      alt={produit.nom}
      width="800"
      height="600"
      loading={prioritaire ? "eager" : "lazy"}
      decoding="async"
      class:list={["object-contain", classe]}
    />
  ) : (
    <div
      role="img"
      aria-label={`Photo à venir : ${produit.nom}`}
      class:list={["flex items-center justify-center text-marque/40", classe]}
    >
      <IconeCategorie icone={produit.categorieIcone} class="h-24 w-24" />
    </div>
  )
}
