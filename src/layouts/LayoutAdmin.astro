---
import "../styles/global.css";

interface Props {
  titre: string;
  sansMenu?: boolean;
}
const { titre, sansMenu = false } = Astro.props;
const boutique = Astro.locals.boutique;
const user = Astro.locals.user;
const { pathname } = Astro.url;
const liens = [
  { href: "/admin", libelle: "Produits" },
  { href: "/admin/categories", libelle: "Catégories" },
  { href: "/admin/reglages", libelle: "Réglages" },
];
const actif = (h: string) =>
  h === "/admin" ? pathname === "/admin" || pathname.startsWith("/admin/produits") : pathname.startsWith(h);
const { marque, marqueFonce, accent } = boutique.couleurs;
---

<!doctype html>
<html lang="fr" style={`--couleur-marque:${marque};--couleur-marque-fonce:${marqueFonce};--couleur-accent:${accent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{titre} | Administration {boutique.nom}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Source+Sans+3:wght@400;600;700&display=swap"
    />
  </head>
  <body class="bg-papier font-texte text-encre antialiased">
    {
      !sansMenu && (
        <header class="border-b border-encre/10 bg-white">
          <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
            <p class="font-titre text-lg font-extrabold text-marque">Administration {boutique.nom}</p>
            <nav class="flex items-center gap-1" aria-label="Administration">
              {liens.map((l) => (
                <a
                  href={l.href}
                  aria-current={actif(l.href) ? "page" : undefined}
                  class:list={[
                    "rounded-lg px-3 py-2 font-bold",
                    actif(l.href) ? "bg-marque text-white" : "text-encre/70 hover:text-marque",
                  ]}
                >
                  {l.libelle}
                </a>
              ))}
            </nav>
            <div class="flex items-center gap-4 text-sm">
              <a href="/" target="_blank" rel="noopener" class="font-bold text-marque underline underline-offset-4">Voir le site</a>
              {user && (
                <form method="post" action="/admin/deconnexion">
                  <button class="font-bold text-encre/70 hover:text-red-700">Déconnexion</button>
                </form>
              )}
            </div>
          </div>
        </header>
      )
    }
    <main class="mx-auto max-w-6xl px-4 py-6">
      <slot />
    </main>
  </body>
</html>
