---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  titre?: string;
  description?: string;
  /** Réserve de l'espace en bas de page quand une barre d'action fixe est affichée (mobile) */
  barreFixe?: boolean;
  noindex?: boolean;
}

const boutique = Astro.locals.boutique;
const { titre, description = boutique.description, barreFixe = false, noindex = false } = Astro.props;
const titreComplet = titre ? `${titre} | ${boutique.nom}` : `${boutique.nom} : ${boutique.slogan}`;
const canonique = Astro.url.origin + Astro.url.pathname;
const { marque, marqueFonce, accent } = boutique.couleurs;
const variablesMarque = `--couleur-marque:${marque};--couleur-marque-fonce:${marqueFonce};--couleur-accent:${accent}`;
---

<!doctype html>
<html lang="fr" style={variablesMarque}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={marque} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CM" />
    <meta property="og:site_name" content={boutique.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Source+Sans+3:wght@400;600;700&display=swap"
    />
    <slot name="head" />
  </head>
  <body class:list={["bg-papier font-texte text-encre antialiased", barreFixe && "pb-24 lg:pb-0"]}>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2"
    >
      Aller au contenu
    </a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
